#!/usr/bin/env bash
# Stamp a new build id into version.json, every page's freshness check, and
# the stylesheet cache-buster. Run this once before committing any change you
# want people to see straight away — see "Freshness" in CLAUDE.md.
set -euo pipefail
cd "$(dirname "$0")/.."

BUILD="$(date -u +%Y%m%d-%H%M%S)"
printf '{"build": "%s"}\n' "$BUILD" > version.json

for page in *.html; do
  sed -i "s/var BUILD = \"[^\"]*\";/var BUILD = \"$BUILD\";/" "$page"
  sed -i "s|css/style\.css?v=[^\"]*|css/style.css?v=$BUILD|g" "$page"
  sed -i "s|js/main\.js?v=[^\"]*|js/main.js?v=$BUILD|g" "$page"
done

echo "stamped build $BUILD"
